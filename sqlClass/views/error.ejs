<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something Went Wrong</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="bg-gray-50 text-gray-800 min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8">
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-sm border border-gray-200 p-8 sm:p-12 text-center">
      
      <!-- Big Error Status & Graphic Icon -->
      <div class="relative flex items-center justify-center mb-6">
        <span class="text-7xl sm:text-9xl font-extrabold text-red-50 select-none tracking-tight">
          500
        </span>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-red-100 flex items-center justify-center text-red-600 shadow-inner">
            <svg class="w-10 h-10 sm:w-12 sm:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Error Headings -->
      <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        Oops! Something Went Wrong
      </h1>
      <p class="text-sm sm:text-base text-gray-500 max-w-md mx-auto mb-8 leading-relaxed">
        Server par koi unexpected error aa gayi hai ya database connect nahi ho pa raha. Kripya thodi der baad dobara koshish karein.
      </p>

      <!-- Optional Dynamic Error Details (Express se pass karne ke liye) -->
      <% if (typeof err !== 'undefined' && err) { %>
        <div class="text-left bg-gray-50 border border-gray-200 rounded-xl p-4 mb-8 overflow-x-auto">
          <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Error Trace:</p>
          <pre class="text-xs text-red-600 font-mono whitespace-pre-wrap break-all"><%= err %></pre>
        </div>
      <% } %>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href="/"
          class="w-full sm:w-auto min-w-[160px] py-3 px-6 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl shadow-sm transition duration-150 ease-in-out text-center cursor-pointer"
        >
          Go to Home Page
        </a>

        <button
          type="button"
          onclick="window.location.reload()"
          class="w-full sm:w-auto min-w-[160px] py-3 px-6 bg-white hover:bg-gray-100 text-gray-700 text-sm font-medium rounded-xl border border-gray-300 shadow-sm transition duration-150 text-center cursor-pointer"
        >
          Refresh Page
        </button>
      </div>

    </div>
  </body>
</html>