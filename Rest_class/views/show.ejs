<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Post In Detail</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="h-screen flex items-center justify-center">
    <div class="text-center space-y-8">
      <h1 class="text-3xl font-bold"><%= post.username %></h1>
      <h3 class="text-2xl font-bold"><%= post.content %></h3>
      <a href="/posts">
        <button
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition duration-200 shadow-md"
        >
          <<-Go Back
        </button>
      </a>
    </div>
  </body>
</html>
