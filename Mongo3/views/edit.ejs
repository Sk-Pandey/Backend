<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Chat</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-slate-50 text-slate-800 min-h-screen antialiased py-10 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-xl mx-auto">
      <!-- Back Link & Header -->
      <div class="mb-6">
        <a
          href="/chats"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors mb-4"
        >
          <!-- Left Arrow Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          Back to all chats
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
          Edit Message
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Update the content of your message below.
        </p>
      </div>

      <!-- Form Card -->
      <div
        class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 shadow-sm"
      >
        <!-- 
          Note: If your backend uses `method-override` for PUT requests, 
          you can change the action to `/chats/<%= chat._id || chat.id %>?_method=PUT`
        -->
        <form
          action="/chats/<%= chat._id || chat.id %>?_method=PUT"
          method="POST"
          class="space-y-5"
        >
          <!-- Disabled / Read-Only Participants -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- From Field -->
            <div>
              <label
                class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5"
              >
                From
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="from"
                  disabled
                  value="<%= chat.from %>"
                  class="w-full px-3.5 py-2 text-sm bg-slate-100 border border-slate-200 rounded-lg text-slate-500 cursor-not-allowed select-none focus:outline-none"
                />
                <span
                  class="absolute right-3 top-2.5 text-slate-400 text-xs font-medium"
                  >Locked</span
                >
              </div>
            </div>

            <!-- To Field -->
            <div>
              <label
                class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5"
              >
                To
              </label>
              <div class="relative">
                <input
                  type="text"
                  name="to"
                  disabled
                  value="<%= chat.to %>"
                  class="w-full px-3.5 py-2 text-sm bg-slate-100 border border-slate-200 rounded-lg text-slate-500 cursor-not-allowed select-none focus:outline-none"
                />
                <span
                  class="absolute right-3 top-2.5 text-slate-400 text-xs font-medium"
                  >Locked</span
                >
              </div>
            </div>
          </div>

          <!-- Message Field -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label
                for="message"
                class="block text-xs font-semibold uppercase tracking-wider text-slate-700"
              >
                Message Content
              </label>
              <span class="text-xs text-indigo-600 font-medium">Editable</span>
            </div>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-3.5 py-2 text-sm bg-white border border-slate-300 rounded-lg text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 resize-y"
            >
<%= chat.message %></textarea
            >
          </div>

          <!-- Action Buttons -->
          <div
            class="pt-2 flex items-center justify-end gap-3 border-t border-slate-100"
          >
            <a
              href="/chats"
              class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 transition duration-150"
            >
              Cancel
            </a>
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer"
            >
              <!-- Checkmark Icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Confirm Changes
            </button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
