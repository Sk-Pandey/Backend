<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Chat</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-slate-50 text-slate-800 min-h-screen antialiased py-10 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-xl mx-auto">
      <!-- Back Link & Header -->
      <div class="mb-6">
        <a
          href="/chats"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          Back to all chats
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">
          Create New Chat
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Fill out the fields below to start a conversation.
        </p>
      </div>

      <!-- Form Card -->
      <div
        class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 shadow-sm"
      >
        <form action="/chats" method="POST" class="space-y-5">
          <!-- From and To Inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- From Field -->
            <div>
              <label
                for="from"
                class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5"
              >
                From
              </label>
              <input
                type="text"
                id="from"
                name="from"
                required
                placeholder="Sender name"
                class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150"
              />
            </div>

            <!-- To Field -->
            <div>
              <label
                for="to"
                class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5"
              >
                To
              </label>
              <input
                type="text"
                id="to"
                name="to"
                required
                placeholder="Receiver name"
                class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150"
              />
            </div>
          </div>

          <!-- Message Field -->
          <div>
            <label
              for="message"
              class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Write your message here..."
              class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-lg text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 resize-y"
            ></textarea>
          </div>

          <!-- Action Buttons -->
          <div class="pt-2 flex items-center justify-end gap-3">
            <a
              href="/chats"
              class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 transition duration-150"
            >
              Cancel
            </a>
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"
                />
              </svg>
              Send Message
            </button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
